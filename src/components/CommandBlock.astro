---
// A command as you would see it in your own terminal: a prompt, the text, and
// nothing around it. The label names the command for screen readers.
interface Props {
  command: string;
  label?: string;
}

const { command, label = "Command" } = Astro.props;
---

<div class="command" data-command>
  <pre class="command-text" tabindex="0" aria-label={label}><span class="command-prompt" aria-hidden="true">$ </span><code>{command}</code></pre>
  <button type="button" class="command-copy" data-copy-button aria-label={`Copy: ${label}`}>Copy</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-button]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.closest("[data-command]")?.querySelector("code")?.textContent;
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.trim());
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1600);
      } catch {
        button.textContent = "Select";
      }
    });
  });
</script>

<style>
  .command {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 1rem;
    min-width: 0;
    max-width: 100%;
  }

  .command-text {
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    padding-block: 0.6rem;
    white-space: pre;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .command-text code {
    overflow-wrap: normal;
  }

  .command-prompt {
    color: var(--brass);
    user-select: none;
  }

  .command-copy {
    flex: none;
    min-width: 3.75rem;
    min-height: 2.75rem;
    color: var(--soft);
    font: 400 var(--size-sm) / 1 var(--font-mono);
    text-align: left;
    cursor: pointer;
  }

  .command-copy:hover {
    color: var(--brass);
  }
</style>
