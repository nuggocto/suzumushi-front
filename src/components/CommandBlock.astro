---
import CopyButton from "./CopyButton.astro";

interface Props {
  command: string;
  label?: string;
}

const { command, label } = Astro.props;
---

<div class="min-w-0" data-command>
  <div class="mb-2 flex min-h-7 items-center justify-between gap-4">
    <p class="text-sm font-medium text-accent">{label ?? "Command"}</p>
    <CopyButton />
  </div>
  <div class="code-block">
    <code>{command}</code>
  </div>
</div>
