---
import { NAV, SITE } from "../data/site";
---

<footer class="site-footer shell small">
  <p>Suzumushi {SITE.version}, a local terminal audio player for Linux. Free and open source.</p>
  <nav class="links" aria-label="Footer navigation">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={SITE.license} target="_blank" rel="noreferrer">Apache-2.0 license</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 3rem;
    padding-block: 4rem 2.5rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--ink);
  }
</style>
