---
import Kanji from "./Kanji.astro";
import { NAV, SITE } from "../data/site";
---

<header class="site-header shell">
  <a href="/" class="brand" aria-label="Suzumushi home">
    <Kanji class="brand-kanji" />
    <span>Suzumushi</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-block: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand :global(.brand-kanji) {
    height: 1.125rem;
    color: var(--brass);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-inline: -0.25rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--muted);
    font-size: var(--size-sm);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }
</style>
