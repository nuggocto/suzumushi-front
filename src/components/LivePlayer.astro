  .key:active {
    transform: translateY(2px);
    border-bottom-width: 1px;
    margin-bottom: 2px;
  }

  .hint {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--size-sm);
  }

  .hint .text-link {
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Narrow screens show one panel at a time, like switching focus with Tab. */
  @media (max-width: 767px) {
    .term {
      height: 30rem;
      padding-inline: 0.5rem;
    }

    .screen {
      grid-template-columns: minmax(0, 1fr);
    }

    .pane:not(.is-focused) {
      display: none;
    }

    .status [data-status-playback] {
      display: none;
    }

    .status :global(.notice) {
      display: block;
    }

    .help dd {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 0.4em;
    }

    .help dd span:last-child {
      color: var(--muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term,
    .key {
      transition: none;
    }
  }
</style>
