---
import { Image } from "astro:assets";
import suzu from "../assets/suzu.png";
---

<figure class="hidden w-full sm:block">
  <div class="aspect-[4/5]">
    <Image
      src={suzu}
      alt="Suzu, a bell cricket cut from charcoal and ivory Japanese paper, holding a small brass bell"
      widths={[160, 224, 448]}
      sizes="(min-width: 1024px) 14rem, 10rem"
      loading="eager"
      class="h-full w-full object-contain"
    />
  </div>
  <figcaption class="mt-2 flex items-center justify-center gap-2 text-sm text-muted">
    <span>Suzu</span>
    <span class="text-accent" aria-hidden="true">·</span>
    <span>Bell cricket</span>
  </figcaption>
</figure>
