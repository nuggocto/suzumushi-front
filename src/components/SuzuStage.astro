---
import { Image } from "astro:assets";
import suzu from "../assets/suzu.png";
---

<figure class="suzu-stage mx-auto w-full max-w-[30rem]">
  <div class="aspect-[4/5]">
    <Image
      src={suzu}
      alt="Suzu, a bell cricket cut from charcoal and ivory Japanese paper, holding a small brass bell"
      widths={[420, 640, 900]}
      sizes="(max-width: 1024px) 80vw, 30rem"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-contain"
    />
  </div>
  <figcaption class="mt-3 flex items-center justify-center gap-3 text-xs tracking-[0.08em] text-soft uppercase">
    <span>Suzu</span>
    <span class="text-accent" aria-hidden="true">·</span>
    <span>Bell cricket</span>
  </figcaption>
</figure>

<style>
  @media (max-width: 720px) {
    .suzu-stage {
      max-width: 17rem;
    }
  }
</style>
