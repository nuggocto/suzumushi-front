---
import { Image } from "astro:assets";
import player from "../assets/player.png";
---

<figure class="terminal-figure">
  <a class="terminal-preview" href={player.src} target="_blank" rel="noreferrer" aria-label="Open the full-size Suzumushi screenshot in a new tab">
    <Image
      src={player}
      alt="Suzumushi playing Mani - Bang Bang, with the folder library on the left, Suzu and the audio spectrum in the middle, and the queue on the right"
      widths={[640, 1120, 1600, 2240]}
      sizes="(max-width: 1152px) calc(100vw - 2rem), 70rem"
      format="png"
      loading="eager"
      fetchpriority="high"
      class="terminal-image"
    />
    <span class="terminal-caption">Open full-size screenshot ↗</span>
  </a>
</figure>

<style>
  .terminal-figure {
    border: 1px solid var(--line);
    background: #0e1214;
  }

  .terminal-preview {
    display: block;
    text-decoration: none;
  }

  .terminal-preview:hover .terminal-caption {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .terminal-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .terminal-caption {
    display: block;
    border-top: 1px solid var(--line);
    padding: 0.85rem 1rem;
    background: var(--panel);
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
