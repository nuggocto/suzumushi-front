---
import { Image } from "astro:assets";
import player from "../assets/player.png";
---

<figure id="player" class="terminal-figure">
  <div class="terminal-heading" aria-hidden="true">
    <span>suzumushi</span>
    <span>real playing state</span>
  </div>

  <div
    class="terminal-viewport desktop-player"
    tabindex="0"
    role="region"
    aria-label="Suzumushi interface screenshot"
  >
    <Image
      src={player}
      alt="Suzumushi playing Mani - Bang Bang, with the folder library on the left, Suzu dancing above the live spectrum, and the queue on the right"
      widths={[720, 1120, 1600, 2240]}
      sizes="(max-width: 720px) 50rem, 70rem"
      format="png"
      loading="lazy"
      class="terminal-image"
    />
  </div>

  <div class="mobile-panels" role="list" aria-label="Suzumushi interface panels">
    <figure class="mobile-panel" role="listitem">
      <figcaption>
        <strong>Library</strong>
        <span>Browse folders and playlists.</span>
      </figcaption>
      <div class="mobile-panel-crop mobile-panel-library">
        <Image src={player} alt="" width={1120} format="png" loading="lazy" class="mobile-panel-image" />
      </div>
    </figure>

    <figure class="mobile-panel" role="listitem">
      <figcaption>
        <strong>Player</strong>
        <span>See playback, volume, and spectrum.</span>
      </figcaption>
      <div class="mobile-panel-crop mobile-panel-player">
        <Image src={player} alt="" width={1120} format="png" loading="lazy" class="mobile-panel-image" />
      </div>
    </figure>

    <figure class="mobile-panel" role="listitem">
      <figcaption>
        <strong>Queue</strong>
        <span>Keep the next tracks in view.</span>
      </figcaption>
      <div class="mobile-panel-crop mobile-panel-queue">
        <Image src={player} alt="" width={1120} format="png" loading="lazy" class="mobile-panel-image" />
      </div>
    </figure>
  </div>
</figure>

<style>
  .terminal-figure {
    overflow: hidden;
    border: 1px solid var(--line);
    background: #0e1214;
  }

  .terminal-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding: 0.7rem 0.9rem;
    color: var(--soft);
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .terminal-viewport {
    overflow-x: auto;
    padding: clamp(0.3rem, 0.7vw, 0.55rem);
    scrollbar-color: var(--accent) var(--panel);
  }

  .terminal-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .mobile-panels {
    display: none;
  }

  @media (max-width: 720px) {
    .terminal-figure {
      border: 0;
      background: transparent;
    }

    .terminal-heading,
    .desktop-player {
      display: none;
    }

    .mobile-panels {
      display: grid;
      gap: 2.5rem;
    }

    .mobile-panel {
      min-width: 0;
    }

    .mobile-panel figcaption {
      display: grid;
      gap: 0.3rem;
      margin-bottom: 0.85rem;
    }

    .mobile-panel figcaption strong {
      color: var(--ink);
      font: 500 1.25rem var(--font-display);
    }

    .mobile-panel figcaption span {
      color: var(--muted);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .mobile-panel-crop {
      position: relative;
      height: 15rem;
      overflow: hidden;
      background: #0e1214;
    }

    .mobile-panel-image {
      position: absolute;
      top: -1.6rem;
      width: 80rem;
      max-width: none;
      height: auto;
    }

    .mobile-panel-library .mobile-panel-image {
      top: 0;
      left: -1.5rem;
    }

    .mobile-panel-player .mobile-panel-image {
      top: -5.5rem;
      left: 50%;
      transform: translateX(-50%);
    }

    .mobile-panel-queue .mobile-panel-image {
      top: 0;
      right: -0.75rem;
    }
  }
</style>
