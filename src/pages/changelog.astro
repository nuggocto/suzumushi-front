---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import { SITE } from "../data/site";

const releases = [
  {
    version: "1.1.6",
    date: "23 September 2026",
    label: "Keep playing through upgrades",
    summary: "Keeps playback, seeking, and metadata reads working when a package upgrade replaces the running executable.",
    changes: [
      "Starts audio and metadata helpers from the running executable image, so an open session keeps working after an upgrade and helpers match the parent's protocol version.",
      "Reports misused init arguments as argument errors and unsafe log storage as a root problem.",
      "Checks queue item byte accounting at compile time and reuses shared bounded-text helpers.",
      "Removes unused path-based scan entry points and stops counting file symlinks as mount decisions.",
      "Consolidates overlapping tests and adds an upgrade regression that also runs in the Nix sandbox.",
      "Updates the Linux archive, AUR package, and stable Nix installation to 1.1.6.",
    ],
  },
  {
    version: "1.1.5",
    date: "15 September 2026",
    label: "Playback fixes and code cleanup",
    summary: "Keeps audio channels aligned during underruns and preserves pause when seeking to a track's end.",
    changes: [
      "Keeps stereo and multichannel output aligned when the decoder falls behind, by publishing and consuming complete audio frames.",
      "Keeps playback paused when seeking exactly to the end of a track, including when advancing to the next track or repeating.",
      "Separates browser/search, queue operations, and playback transitions into focused modules with clearer state ownership.",
      "Simplifies audio worker steps, decoder header writes, and desktop volume rounding.",
      "Strengthens logging shutdown, queue-drop, channel alignment, and decoded seek tests, and removes misleading assertions.",
      "Updates stable Nix installation to v1.1.5 and adds a code map for contributors. Existing commands, configuration files, and saved sessions remain compatible.",
    ],
  },
  {
    version: "1.1.4",
    date: "12 September 2026",
    label: "Playback reliability",
    summary: "Preserves track endings, fixes paused playback and desktop controls, and adds stable Nix installation.",
    changes: [
      "Preserves the end of tracks by waiting for buffered audio before closing playback.",
      "Keeps next, previous, and seeking silent while playback is paused, including on native PipeWire.",
      "Keeps desktop PlayPause and Play working after clearing the queue while a track remains active.",
      "Applies the scan entry limit to rejected filenames as well as accepted paths.",
      "Rejects malformed WAV channel counts and limits header inspection.",
      "Adds stable Nix installation from the v1.1.4 tag, with package build and installation checks in CI.",
    ],
  },
  {
    version: "1.1.3",
    date: "5 September 2026",
    label: "Faster repeat startup",
    summary: "Reuses metadata between sessions and reduces background work.",
    changes: [
      "Caches metadata for unchanged files, avoiding a new parser process for each cached track when the player reopens.",
      "Bounds the private metadata cache to 4 MiB and 10,000 entries. Changed files are reparsed, and diagnose only reads the cache.",
      "Stops the audio worker's periodic polling while no track is active.",
      "Updates position-only now-playing state once per second while keeping control changes immediate.",
      "Counts underruns when the decoder falls behind without counting normal end-of-track silence.",
      "Removes duplicate playlist storage, unused fields and wrappers, and an unused reservation for a second library index.",
      "Strengthens scanner, cache, state-write, and audio regression tests. Terminal tests now wait for readiness and clean up child processes after failed assertions.",
    ],
  },
  {
    version: "1.1.2",
    date: "5 September 2026",
    label: "Playback fixes",
    summary: "More reliable playback, seeking, and startup.",
    changes: [
      "Stops previous playback before reporting a failed track change, so a missing next file cannot leave audio playing behind an error message.",
      "Keeps playback progress and saved positions updating after successful seeks.",
      "Renders valid tracks shorter than one millisecond without crashing.",
      "Restarts completed tracks from the beginning when Play is pressed, including tracks with an unknown duration.",
      "Preserves the next queue item when the playing item and earlier entries are removed.",
      "Retains admitted tracks when library scanning reaches its entry or path limit, while enforcing the remaining resource limits.",
      "Continues terminal startup after two seconds if the desktop session bus is unresponsive.",
      "Updates rtrb to 0.3.5 for RUSTSEC-2026-0274.",
    ],
  },
  {
    version: "1.1.1",
    date: "18 August 2026",
    label: "Reliability",
    summary: "The release pipeline learned to guard against its own failures.",
    changes: [
      "Materialises the pinned Rust toolchain before the release workflow's parallel cargo installs, eliminating the rustup download race that failed the 1.1.0 run.",
    ],
  },
  {
    version: "1.1.0",
    date: "18 August 2026",
    label: "Hardening",
    summary: "The player became more resilient against malformed audio and unruly devices.",
    changes: [
      "Updated Symphonia to 0.6.1 for its malformed-input hardening and decoder fixes.",
      "Limited cumulative metadata-helper work to one minute per scan, then continued discovery with filename-only entries and one visible warning.",
      "Prefers the native PipeWire backend with RTKit scheduling when available, keeping ALSA as the fallback.",
      "Plays 44.1 kHz tracks on a 48 kHz PipeWire graph by opening the output stream at the track's own rate.",
      "Turns recoverable device errors into counted, logged reports instead of ending playback, and stops counting expected end-of-track padding as a dropout.",
    ],
  },
  {
    version: "1.0.2",
    date: "13 August 2026",
    label: "Polish",
    summary: "The finished player got a leaner, stricter release.",
    changes: [
      "Made hard-linked paths share one verified asset, metadata parse, and Queue identity.",
      "Removed temporary allocations from natural path sorting and reduced the release binary size.",
      "Replaced metadata-helper sleep polling with Linux process-descriptor notification when available.",
      "Added clean-checkout fuzz seeds and disabled Cargo publication for the application crate.",
    ],
  },
  {
    version: "1.0.1",
    date: "12 August 2026",
    label: "Spectrum",
    summary: "The Player learned to follow the shape of the sound.",
    changes: [
      "Added a compact, dependency-free 16-band spectrum driven by the audio reaching the output device.",
      "Kept stereo-width and opposite-polarity audio visible by combining independently filtered channel energy.",
      "Made the spectrum fall quiet immediately when playback pauses or stops.",
    ],
  },
  {
    version: "1.0.0",
    date: "12 August 2026",
    label: "Stable",
    summary: "The complete local player, release pipeline, and Arch package.",
    changes: [
      "Published the verified suzumushi-bin package to AUR.",
      "Added session-only Library folder collapse without hiding search results or changing playback.",
      "Made Enter play or pause outside Library and clarified previous and next controls.",
      "Prevented the same underlying audio asset from entering the Queue twice while keeping playlist additions atomic.",
      "Cleared informational footer notices after three seconds while preserving warnings and errors.",
    ],
  },
  {
    version: "0.4.0",
    date: "10 August 2026",
    label: "Desktop",
    summary: "The terminal player learned to speak to the Linux desktop.",
    changes: [
      "Added MPRIS, global media keys, playerctl controls, and bounded metadata.",
      "Finished the built-in key guide, failure states, and installed-binary QA.",
      "Kept desktop actions routed through the same app-owned playback state.",
    ],
  },
  {
    version: "0.3.0",
    date: "10 August 2026",
    label: "Playback",
    summary: "Folders became a library, and Suzu began to dance.",
    changes: [
      "Added the nested library, folder playlists, local search, and bounded Queue.",
      "Added MP3, FLAC, WAV/PCM, and Ogg/Vorbis playback with seeking, shuffle, and repeat.",
      "Added paused session restoration and the original terminal-native Suzu animation.",
    ],
  },
  {
    version: "0.2.0",
    date: "10 August 2026",
    label: "Foundation",
    summary: "The safe local foundation and terminal shell arrived.",
    changes: [
      "Added strict root initialization, descriptor-relative scanning, private logs, and bounded parsing.",
      "Added the keyboard-first terminal interface and the canonical suzumushi command.",
      "Established the complete CI, security, MSRV, and fuzzing gates.",
    ],
  },
] as const;
---

<Layout title="Changelog" description={`The Suzumushi release history, through version ${SITE.version}.`}>
  <section class="section shell">
    <p class="eyebrow">Release notes</p>
    <h1 class="page-title mt-4">Changelog.</h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-muted">What changed in each Suzumushi release.</p>
  </section>

  <section class="shell pb-24">
    <div class="relative mt-8">
      <div class="absolute top-0 bottom-0 left-[0.34rem] w-px bg-line sm:left-[8.45rem]"></div>
      <div class="grid gap-12">
        {releases.map((release, index) => (
          <article class="relative grid gap-4 pl-8 sm:grid-cols-[7.2rem_1fr] sm:gap-10 sm:pl-0">
            <div class="sm:text-right">
              <div class:list={["absolute top-2 left-0 size-3 border-2 border-night sm:left-[8.1rem]", index === 0 ? "bg-accent" : "bg-soft"]}></div>
              <p class="font-mono text-xs text-ink">v{release.version}</p>
              <p class="mt-1 font-mono text-xs leading-relaxed text-soft">{release.date}</p>
            </div>
            <div class="panel p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="section-title text-ink">{release.label}</h2>
                {index === 0 && <span class="border border-line px-3 py-1 text-xs font-medium text-muted">current</span>}
              </div>
              <p class="mt-3 text-muted">{release.summary}</p>
              <ul class="mt-6 grid gap-3 leading-relaxed text-muted">
                {release.changes.map((change) => <li class="flex gap-3"><span class="mt-[0.65rem] size-1 shrink-0 bg-accent"></span><span>{change}</span></li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-center gap-3">
      <ButtonLink href={SITE.release} external>Read the v{SITE.version} release ↗</ButtonLink>
      <ButtonLink href={`${SITE.github}/blob/shrek/CHANGELOG.md`} variant="secondary" external>Complete changelog ↗</ButtonLink>
    </div>
  </section>
</Layout>
