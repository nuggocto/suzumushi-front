---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import SuzuStage from "../components/SuzuStage.astro";
import TerminalPlayer from "../components/TerminalPlayer.astro";
import { SITE } from "../data/site";

const features = [
  {
    title: "Find a track, build a queue",
    description: "Search by artist, title, or filename. Add a track or a whole playlist, then reorder the queue from your keyboard.",
  },
  {
    title: "Pick up where you stopped",
    description: "Your queue, current track, and playback position are saved. Reopen the player and press play when you're ready.",
  },
  {
    title: "Use your media keys",
    description: "Play, pause, and skip from the terminal or your desktop's media controls. Both control the same player.",
  },
  {
    title: "Keep your library local",
    description: "Audio and playlists live in your Suzumushi folders. No account, streaming service, or cloud library required.",
  },
] as const;
---

<Layout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">A terminal music player for Linux</p>
      <h1 id="hero-title" class="page-title mt-4">Keep your music close.</h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-muted">
        Browse your local library, build a queue, and return to your saved playback position. No account required.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <ButtonLink href="/install">Install for Linux</ButtonLink>
        <ButtonLink href="#player" variant="secondary">See the player</ButtonLink>
      </div>
      <p class="mt-5 text-sm text-muted">Free and open source · v{SITE.version} · GNU/Linux x86-64</p>
    </div>
    <SuzuStage />
  </section>

  <section id="player" class="shell pb-14 sm:pb-16" aria-labelledby="player-title">
    <div class="mb-6">
      <h2 id="player-title" class="section-title">Browse, queue, and play from your keyboard.</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">Your library on the left, playback in the middle, and the queue on the right. Suzu follows the music.</p>
    </div>
    <TerminalPlayer />
    <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted" aria-label="Player keyboard shortcuts">
      <li><kbd>/</kbd> Search your library</li>
      <li><kbd>Tab</kbd> Switch panels</li>
      <li><kbd>Space</kbd> Play or pause</li>
      <li><kbd>?</kbd> Show all keys</li>
    </ul>
  </section>

  <section class="border-y border-line bg-panel/40" aria-labelledby="features-title">
    <div class="section shell">
      <h2 id="features-title" class="section-title">The essentials for everyday listening.</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 sm:gap-x-12">
        {features.map((feature) => (
          <article>
            <h3 class="font-semibold text-ink">{feature.title}</h3>
            <p class="mt-3 max-w-lg leading-relaxed text-muted">{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="first-listen-title">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <h2 id="first-listen-title" class="section-title">Your first listen.</h2>
        <p class="mt-4 max-w-lg leading-relaxed text-muted">
          After installation, create a Suzumushi folder and add your audio to its library. Suzumushi reads that library; it doesn't automatically scan your Music folder.
        </p>
        <a class="text-link mt-5 inline-block" href="/install#first-library">Read the setup instructions →</a>
      </div>
      <ol class="setup-steps">
        <li>
          <h3 class="font-semibold">Create your library</h3>
          <code>suzumushi init ./suzumushi</code>
        </li>
        <li>
          <h3 class="font-semibold">Add your audio</h3>
          <p class="mt-2 leading-relaxed text-muted">Copy audio files or folders into <code>./suzumushi/audio/library/</code>.</p>
        </li>
        <li>
          <h3 class="font-semibold">Open the player</h3>
          <code>suzumushi --root ./suzumushi</code>
          <p class="mt-2 leading-relaxed text-muted">Select a track in Library and press <kbd>Enter</kbd> to add it and start listening.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="border-y border-line bg-panel" aria-labelledby="install-title">
    <div class="section shell flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-10">
      <div>
        <h2 id="install-title" class="section-title">Ready to listen?</h2>
        <p class="mt-3 max-w-xl leading-relaxed text-muted">Install from the AUR on Arch Linux, use the flake on NixOS, or download the x86-64 GNU/Linux archive.</p>
        <p class="mt-4 text-sm text-muted">MP3 · FLAC · 16-bit PCM WAV · Ogg Vorbis</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <ButtonLink href="/install">Install for Linux</ButtonLink>
        <ButtonLink href={SITE.github} variant="secondary" external>View source ↗</ButtonLink>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 10rem;
      padding-block: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 14rem;
    }
  }
</style>
