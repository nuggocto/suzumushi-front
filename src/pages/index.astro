---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CommandBlock from "../components/CommandBlock.astro";
import Kanji from "../components/Kanji.astro";
import LivePlayer from "../components/LivePlayer.astro";
import RailSample from "../components/RailSample.astro";
import suzu from "../assets/suzu.png";
import { SITE } from "../data/site";

const installerCommand = `curl -fsS https://${SITE.domain}/install.sh | sh`;

const features = [
  {
    title: "Find a track, build a queue",
    description: "Search by artist, title, or filename. Add a track or a whole playlist, then reorder the queue from your keyboard.",
    sample: [
      ["/", "search artist, title, filename, and path"],
      ["Enter", "add a track or a whole playlist"],
      ["J or K", "move the selected item down or up"],
    ],
  },
  {
    title: "Pick up where you stopped",
    description: "Your queue, current track, and playback position are saved. Reopen the player and press play when you're ready.",
    sample: [["State: Paused   Volume 50%"], { rail: 86 / 220, time: "1:26 / 3:40" }, ["Session restored; Space resumes"]],
  },
  {
    title: "Use your media keys",
    description: "Play, pause, and skip from the terminal or your desktop's media controls. Both control the same player.",
    sample: [["playerctl --player=suzumushi play-pause"], ["playerctl --player=suzumushi next"], ["playerctl --player=suzumushi metadata"]],
  },
  {
    title: "Keep your library local",
    description: "Audio and playlists live in your Suzumushi folders. No account, streaming service, or cloud library required.",
    sample: [
      ["suzumushi/audio/"],
      ["├── library/"],
      ["│   ├── Music/"],
      ["│   └── Audiobooks/"],
      ["└── playlists/"],
      ["    └── Evening/"],
    ],
  },
] as const;

const steps = [
  { title: "Create your library", command: "suzumushi init ./suzumushi" },
  { title: "Add your audio", path: "./suzumushi/audio/library/" },
  { title: "Open the player", command: "suzumushi --root ./suzumushi" },
] as const;
---

<Layout>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="display">Keep your music close.</h1>
      <p class="hero-lede">
        Suzumushi is a terminal music player for Linux. Browse your local library, build a queue, and return to your saved playback position. No account required.
      </p>
      <div class="hero-install">
        <CommandBlock command={installerCommand} label="Install Suzumushi" />
        <p class="small">
          Version {SITE.version} for x86-64 GNU/Linux, installed to <code>~/.local/bin</code> without sudo.
        </p>
      </div>
      <p class="links small">
        <a href="/install">Other ways to install</a>
        <a href={SITE.github} target="_blank" rel="noreferrer">View source</a>
      </p>
    </div>

    <figure class="hero-figure">
      <div class="suzu">
        <Image
          src={suzu}
          alt="Suzu, a bell cricket cut from charcoal and ivory Japanese paper, holding a small brass bell"
          widths={[320, 480, 720, 960]}
          sizes="(min-width: 900px) 30rem, 72vw"
          loading="eager"
          fetchpriority="high"
          class="suzu-image"
        />
      </div>
      <Kanji vertical class="hero-kanji" />
    </figure>
  </section>

  <section id="player" class="shell" aria-label="Try the player">
    <LivePlayer />
  </section>

  <section class="section shell" aria-labelledby="features-title">
    <h2 id="features-title" class="display section-heading">The essentials for everyday listening.</h2>
    <p class="measure section-lede">
      Your library on the left, playback in the middle, and the queue on the right. Suzu dances in a night meadow that grows with the music.
    </p>
    <div class="features">
      {
        features.map((feature) => (
          <article class="feature">
            <div>
              <h3 class="title">{feature.title}</h3>
              <p class="feature-text">{feature.description}</p>
            </div>
            <div class="sample">
              {feature.sample.map((line) =>
                "rail" in line ? (
                  <span class="sample-line">
                    <RailSample cells={20} progress={line.rail} status="Paused" />
                    {`  ${line.time}`}
                  </span>
                ) : line.length === 2 ? (
                  <span class="sample-line">
                    <span class="sample-key">{line[0]}</span>
                    {line[1]}
                  </span>
                ) : (
                  <span class="sample-line">{line[0]}</span>
                ),
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell" aria-labelledby="first-listen-title">
    <h2 id="first-listen-title" class="display section-heading">Your first listen.</h2>
    <p class="measure section-lede">
      After installation, create a Suzumushi folder and add your audio to its library. Suzumushi reads that library; it doesn't automatically scan your Music folder.
    </p>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <h3 class="title">
              <span class="step-number mono" aria-hidden="true">
                {index + 1}
              </span>
              {step.title}
            </h3>
            <div class="step-body">
              {"command" in step ? (
                <CommandBlock command={step.command} label={step.title} />
              ) : (
                <p>
                  Copy audio files or folders into <code>{step.path}</code>
                </p>
              )}
              {index === 2 && (
                <p>
                  Select a track in Library and press <kbd>Enter</kbd> to add it and start listening.
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="small"><a href="/install#first-library">Read the setup instructions</a></p>
  </section>

  <section class="section closing shell" aria-labelledby="install-title">
    <h2 id="install-title" class="display">Ready to listen?</h2>
    <p class="measure section-lede">Install with one command on x86-64 GNU/Linux, from the AUR on Arch Linux, or with the flake on NixOS.</p>
    <CommandBlock command={installerCommand} label="Install Suzumushi" />
    <p class="links small closing-links">
      <a href="/install">Other ways to install</a>
      <a href={SITE.github} target="_blank" rel="noreferrer">View source</a>
    </p>
    <p class="small">Plays MP3, FLAC, 16-bit PCM WAV, and Ogg Vorbis.</p>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: 2rem 3.5rem;
  }

  .hero > * {
    min-width: 0;
  }

  .hero-lede {
    max-width: 33rem;
    margin: 1.75rem 0 0;
  }

  .hero-install {
    margin-top: 2rem;
  }

  .hero-install p {
    margin: 0;
  }

  .hero-copy .links {
    margin: 1.25rem 0 0;
  }

  .hero-figure {
    position: relative;
    justify-self: center;
    width: min(72vw, 22rem);
    margin: 0;
  }

  /* The one unprompted motion on the page: Suzu comes out of the dark. */
  .suzu {
    display: block;
    width: 100%;
    animation: emerge 2.4s ease-out both;
  }

  .suzu :global(.suzu-image) {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes emerge {
    from {
      opacity: 0;
    }
  }

  .hero-figure :global(.hero-kanji) {
    position: absolute;
    top: 40%;
    right: 0;
    width: var(--size-lg);
    color: var(--brass);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: 3rem;
      align-items: end;
      padding-block: 0.5rem 4.5rem;
    }

    .hero-copy {
      padding-bottom: 3rem;
    }

    .hero-figure {
      width: 100%;
    }
  }

  .section {
    padding-top: 6rem;
  }

  .section-heading {
    max-width: 16ch;
  }

  .section-lede {
    margin: 1.75rem 0 0;
  }

  .features {
    display: grid;
    gap: 3.5rem;
    margin-top: 4rem;
  }

  .feature {
    display: grid;
    gap: 1.25rem;
  }

  .feature > * {
    min-width: 0;
  }

  .feature-text {
    max-width: 30rem;
    margin: 0.5rem 0 0;
  }

  .sample {
    display: grid;
    overflow-x: auto;
    color: var(--ink);
    font: 400 var(--size-sm) / 1.7 var(--font-mono);
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .sample-line {
    display: block;
    white-space: pre;
  }

  .sample-key {
    display: inline-block;
    min-width: 8ch;
    color: var(--brass);
  }

  .steps {
    display: grid;
    gap: 2.5rem;
    margin: 4rem 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.5rem;
  }

  .step > * {
    min-width: 0;
  }

  .step-number {
    display: inline-block;
    width: 2rem;
    color: var(--brass);
  }

  .step-body {
    padding-left: 2rem;
  }

  .step-body p {
    margin: 0;
  }

  .step-body p + p,
  .step-body :global(.command) + p {
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .feature,
    .step {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
      align-items: start;
    }

    .step-body {
      padding-left: 0;
    }

    /* A command's first line sits on the same baseline as its step title. */
    .step-body :global(.command-text),
    .step-body :global(.command-copy) {
      margin-top: -0.45rem;
    }
  }

  .closing :global(.command) {
    margin-top: 2rem;
  }

  .closing-links {
    margin: 1.25rem 0 1.5rem;
  }

  .closing > p:last-child {
    margin: 0;
    color: var(--soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .suzu {
      animation: none;
    }
  }
</style>
